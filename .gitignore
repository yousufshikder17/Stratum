# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Local configuration and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*
secrets*

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Local research artifacts. Adapters may be source-controlled; downloaded or
# licensed source data and generated research outputs must not be committed.
data/
datasets/
results/
artifacts/
snapshots/
*.duckdb
*.duckdb.wal

# ...except the examples/ bundle, which is small synthetic fixture data and is
# committed on purpose: it is how the pipeline is demonstrated, how the README
# quickstart is verifiable, and what CI's smoke step runs. The store and
# snapshots it generates stay ignored by the rules above.
!examples/data/
!examples/data/*.csv

# Docs build
site/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
