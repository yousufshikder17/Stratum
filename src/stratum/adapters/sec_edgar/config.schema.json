{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sec_edgar adapter configuration",
  "type": "object",
  "properties": {
    "user_agent": {
      "type": "string",
      "description": "SEC-required identifying User-Agent (name + contact email)."
    },
    "forms": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["10-K", "10-Q", "8-K"],
      "description": "Form types to ingest (amendments of these are always included)."
    },
    "ciks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Required CIK allowlist. Use SEC bulk archives for full-market coverage."
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "default": ["Assets", "Liabilities", "Revenues", "NetIncomeLoss", "StockholdersEquity"],
      "description": "XBRL concepts to ingest from Company Facts."
    },
    "timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 30
    }
  },
  "required": ["user_agent", "ciks"],
  "additionalProperties": false
}
