{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "parquet_panel exporter configuration",
  "type": "object",
  "properties": {
    "output_dir": { "type": "string" },
    "partitioning": {
      "type": "string",
      "enum": ["by_signal", "by_entity", "flat"],
      "default": "by_signal"
    }
  },
  "required": ["output_dir"],
  "additionalProperties": false
}
